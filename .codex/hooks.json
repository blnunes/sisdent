{
  "description": "Prevents Codex from completing a code change that fails quality or formatting validation.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/mcp/quality-gate.mjs\" --stop-hook",
            "timeout": 300,
            "statusMessage": "Running the Java quality gate"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/mcp/formatting-gate.mjs\" --stop-hook",
            "timeout": 120,
            "statusMessage": "Checking code formatting"
          }
        ]
      }
    ]
  }
}
