extend type Query {
    patients(organizationId: ID!, clinicUnitId: ID, page: CataloguePageInput, filter: PatientFilterInput): PatientPage!
    patientFilterOptions(organizationId: ID!, clinicUnitId: ID, field: String!, query: String): [FilterOption!]!
    currentAccount: Account!
    platformAccounts(page: AccountPageInput, filter: String): AccountPage!
    platformAccount(accountId: ID!): Account!
    organizationAccounts(organizationId: ID!, page: AccountPageInput, filter: String): AccountPage!
    organizationAccount(organizationId: ID!, accountId: ID!): Account!
    platformOrganizations: [Organization!]!
    """Active clinic units visible in an authorized organization scope."""
    clinicUnits(organizationId: ID!, clinicUnitId: ID): [ClinicUnit!]!
    """Active and inactive practitioners visible to authorized practitioner managers."""
    practitioners(organizationId: ID!): [Practitioner!]!
    appointments(organizationId: ID!, clinicUnitId: ID, from: String!, to: String, page: Int, size: Int): AppointmentPage!
    appointment(organizationId: ID!, clinicUnitId: ID, appointmentId: ID!): Appointment!
    performedProcedures(organizationId: ID!, clinicUnitId: ID, appointmentId: ID!): [PerformedProcedure!]!
}

type ClinicUnit {
    id: ID!
    organizationId: ID!
    name: String!
    active: Boolean!
}

type Practitioner {
    globalId: ID!
    displayName: String!
    registrationNumber: String
    accountId: ID
    active: Boolean!
    specialityIds: [ID!]!
}

type AccountPage { content: [Account!]!, page: Int!, size: Int!, totalElements: Int!, totalPages: Int! }
type Account { id: ID!, displayName: String!, email: String!, active: Boolean!, platformAdministrator: Boolean!, version: Int!, memberships: [Membership!]! }
type Membership { id: ID!, organizationId: ID!, organizationName: String!, clinicUnitId: ID, clinicUnitName: String, role: MembershipRole!, version: Int! }
type Organization { id: ID!, name: String!, active: Boolean! }
input AccountPageInput { page: Int, size: Int, sort: String, direction: SortDirection }
enum MembershipRole { ORGANIZATION_ADMIN MANAGER READ_ONLY PRACTITIONER_MANAGER APPOINTMENT_MANAGER APPOINTMENT_READER CLINICAL_READER CLINICAL_AUTHOR CLINICAL_MANAGER }
enum AppointmentStatus { SCHEDULED CANCELLED COMPLETED NO_SHOW }
type AppointmentPage { content: [Appointment!]!, page: Int!, size: Int!, totalElements: Int!, totalPages: Int! }
type Appointment { globalId: ID!, clinicUnitId: ID!, patientId: ID!, patientName: String!, practitionerId: ID!, practitionerName: String!, startAt: String!, endAt: String!, schedulingTimezone: String!, status: AppointmentStatus! }
type PerformedProcedure { globalId: ID!, dentalProcedureId: ID!, procedureNameSnapshot: String!, performedAt: String!, administrativeNote: String, voidedAt: String, voidedBy: String, voidReason: String }
