type Mutation {
    createCountry(input: CountryMutationInput!, locale: String): Country!
    updateCountry(id: ID!, input: CountryMutationInput!, locale: String): Country!
    deleteCountry(id: ID!): Boolean!
    createSpeciality(input: SpecialityMutationInput!, locale: String): Speciality!
    updateSpeciality(id: ID!, input: SpecialityMutationInput!, locale: String): Speciality!
    deactivateSpeciality(id: ID!): Boolean!
    createAdministrativeDivision(input: AdministrativeDivisionMutationInput!): AdministrativeDivision!
    updateAdministrativeDivision(id: ID!, input: AdministrativeDivisionMutationInput!): AdministrativeDivision!
    deleteAdministrativeDivision(id: ID!): Boolean!
    createAddress(input: AddressMutationInput!): Address!
    updateAddress(id: ID!, input: AddressMutationInput!): Address!
    deleteAddress(id: ID!): Boolean!
    replaceCatalogTranslations(type: CatalogResourceType!, id: ID!, translations: [CatalogTranslationMutationInput!]!): CatalogTranslationEntry!
    createClinicUnit(organizationId: ID!, input: ClinicUnitMutationInput!): ClinicUnit!
    createPractitioner(organizationId: ID!, input: PractitionerMutationInput!): Practitioner!
    updatePractitioner(organizationId: ID!, practitionerId: ID!, input: PractitionerMutationInput!): Practitioner!
    deactivatePractitioner(organizationId: ID!, practitionerId: ID!): Boolean!
    createPlatformAccount(input: AccountCreateInput!): Account!
    changeAccountLifecycle(accountId: ID!, input: AccountLifecycleInput!): Account!
    changeAccountPlatformAdministrator(accountId: ID!, input: AccountPlatformAdministratorInput!): Account!
    createOrganization(input: OrganizationInput!): Organization!
    createMembership(organizationId: ID!, input: MembershipInput!): Membership!
    grantMembership(organizationId: ID!, input: AccountMembershipInput!): Membership!
    changeMembershipRole(organizationId: ID!, membershipId: ID!, input: MembershipRoleUpdateInput!): Membership!
    revokeMembership(organizationId: ID!, membershipId: ID!, input: MembershipRevokeInput!): Boolean!
    createPatient(organizationId: ID!, clinicUnitId: ID, input: PatientMutationInput!): Patient!
    updatePatient(organizationId: ID!, clinicUnitId: ID, patientId: ID!, input: PatientMutationInput!): PatientMutationResult!
    deactivatePatient(organizationId: ID!, clinicUnitId: ID, patientId: ID!): Boolean!
    exactPatientMatch(organizationId: ID!, clinicUnitId: ID, input: ExactPatientMatchInput!): ExactPatientMatch!
    linkPatient(organizationId: ID!, input: PatientLinkMutationInput!): PatientLink!
}

input CountryMutationInput { name: String!, code: String!, continent: Continent! }
input CatalogTranslationMutationInput { locale: String!, value: String! }
input DentalProcedureMutationInput { id: ID, name: String!, translations: [CatalogTranslationMutationInput!] }
input SpecialityMutationInput {
    name: String!
    procedures: [DentalProcedureMutationInput!]!
    translations: [CatalogTranslationMutationInput!]
}
input ClinicUnitMutationInput { name: String! }
input AdministrativeDivisionMutationInput { name: String!, code: String!, type: String!, countryCode: String! }
input AddressMutationInput { street: String!, district: String, city: String!, additionalInfo: String, block: String, postalCode: String!, administrativeDivision: AdministrativeDivisionReferenceInput, countryCode: String! }
input AdministrativeDivisionReferenceInput { name: String!, code: String!, type: String! }
type AdministrativeDivision { id: ID!, name: String!, code: String!, type: String!, country: Country! }
input PractitionerMutationInput {
    displayName: String!
    registrationNumber: String
    accountId: ID
    specialityIds: [ID!]!
}
input AccountCreateInput { displayName: String!, email: String!, password: String! }
input AccountLifecycleInput { active: Boolean!, version: Int! }
input AccountPlatformAdministratorInput { platformAdministrator: Boolean!, version: Int! }
input OrganizationInput { name: String! }
input MembershipInput { email: String!, displayName: String!, password: String!, clinicUnitId: ID, role: MembershipRole! }
input AccountMembershipInput { email: String!, clinicUnitId: ID, role: MembershipRole! }
input MembershipRoleUpdateInput { role: MembershipRole!, version: Int! }
input MembershipRevokeInput { version: Int! }
input PatientAddressMutationInput {
    street: String!, district: String, city: String!, additionalInfo: String, block: String, postalCode: String!
    administrativeDivision: PatientAdministrativeDivisionMutationInput, countryCode: String!
}
input PatientAdministrativeDivisionMutationInput { name: String!, code: String!, type: String! }
input PatientMutationInput {
    name: String!, birthDate: String!, active: Boolean!, gender: Gender!, taxId: String,
    identificationType: DocumentType!, identificationNumber: String!, documentIssuerCountryCode: String!,
    nationalityCode: String!, addressId: ID, address: PatientAddressMutationInput, specialityIds: [ID!]!
}
type PatientMutationResult { globalId: ID!, name: String!, active: Boolean! }
input ExactPatientMatchInput { documentType: DocumentType!, issuerCountryCode: String!, documentNumber: String!, birthDate: String! }
input PatientLinkMutationInput { documentType: DocumentType!, issuerCountryCode: String!, documentNumber: String!, birthDate: String!, clinicUnitId: ID, operationalBasis: PatientLinkBasis! }
type ExactPatientMatch { possibleMatchExists: Boolean! }
type PatientLink { id: ID!, patientId: ID!, organizationId: ID!, clinicUnitId: ID, operationalBasis: PatientLinkBasis!, createdBy: String!, createdAt: String! }
enum PatientLinkBasis { INTAKE ATTENDANCE }
type PatientPage { content: [Patient!]!, page: Int!, size: Int!, totalElements: Int!, totalPages: Int! }
type Patient { id: ID!, globalId: ID!, name: String!, birthDate: String!, active: Boolean!, gender: Gender!, taxId: String, identificationType: DocumentType!, identificationNumber: String!, documentIssuerCountry: Country!, nationality: Country!, address: Address, specialities: [Speciality!]! }
input PatientFilterInput { id: ID, name: String, birthDate: String, active: Boolean, gender: Gender, taxId: String, identificationType: DocumentType, identificationNumber: String, nationalityCode: String, addressId: ID, specialityId: ID }
enum Gender { FEMALE MALE OTHER }
enum DocumentType { NATIONAL_ID_CARD PASSPORT }
